{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint",
    "check:install-scripts": "node scripts/check-install-scripts.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:compat": "tsc6 --noEmit",
    "test": "NODE_OPTIONS=--no-deprecation jest",
    "test:watch": "NODE_OPTIONS=--no-deprecation jest --watch",
    "test:ci": "NODE_OPTIONS=--no-deprecation jest --ci",
    "test:coverage": "NODE_OPTIONS=--no-deprecation jest --coverage && node scripts/coverage-summary.cjs",
    "e2e:clean": "rm -rf playwright-report test-results blob-report",
    "e2e:modules": "npm run e2e:clean && node ./scripts/e2e-modules.cjs",
    "e2e:module": "npm run e2e:clean && node ./scripts/e2e-module.cjs",
    "e2e:coverage": "npm run e2e:clean && npm run test:e2e",
    "e2e:coverage:module": "npm run e2e:clean && node ./scripts/e2e-coverage-module.cjs",
    "e2e": "playwright test",
    "e2e:desktop": "playwright test --project=\"Desktop Chrome\"",
    "e2e:mobile": "playwright test --project=\"Mobile Chrome\"",
    "e2e:tablet": "playwright test --project=\"Tablet\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@react-oauth/google": "0.13.5",
    "@types/react-google-recaptcha": "2.1.9",
    "axios": "1.20.0",
    "fuse.js": "7.5.0",
    "js-cookie": "3.0.8",
    "jwt-decode": "4.0.0",
    "lucide-react": "1.34.0",
    "next": "16.3.8",
    "next-intl": "4.14.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-google-recaptcha": "3.1.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/jest": "30.0.0",
    "@types/js-cookie": "3.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-playwright": "2.11.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.16.1": true,
    "unrs-resolver@1.11.1": true
  },
  "overrides": {
    "minimatch": "10.2.6",
    "flatted": "3.4.4",
    "brace-expansion": "5.0.12",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
